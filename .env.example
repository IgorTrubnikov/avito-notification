# Заполнить локально на VPS. Не публиковать этот файл с настоящими значениями.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
POLL_SECONDS=120

# Только Telegram; Авито подключается напрямую. Пусто = без прокси.
TELEGRAM_PROXY_URL=

# false = обычный Chromium с экраном через SSH-туннель; true = без окна.
MONITOR_HEADLESS=true
